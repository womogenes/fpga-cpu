{
    "configurations": [
        {
            "name": "LiteX VexRiscv",
            "compilerPath": "/usr/bin/riscv64-elf-gcc",
            "compilerArgs": [
                "-march=rv32i2p0_m",
                "-mabi=ilp32"
            ],
            "defines": [
                "__vexriscv__",
                "MICROPY_FLOAT_IMPL=MICROPY_FLOAT_IMPL_FLOAT"
            ],
            "includePath": [
                "${workspaceFolder}/proj/build/fpga_soc/software/include",
                "${workspaceFolder}/proj/sw/runtime/include",
                "${workspaceFolder}/proj/sw/text_console/include",
                "${workspaceFolder}/proj/sw/micropython_repl",
                "${workspaceFolder}/proj/sw/micropython_repl/vendor/micropython",
                "${workspaceFolder}/proj/sw/micropython_repl/build"
            ],
            "cStandard": "gnu99"
        }
    ],
    "version": 4
}
