diff --git a/corev_apu/fpga/src/bootrom/Makefile b/corev_apu/fpga/src/bootrom/Makefile
--- a/corev_apu/fpga/src/bootrom/Makefile
+++ b/corev_apu/fpga/src/bootrom/Makefile
@@ -23,12 +23,14 @@ UART_BITRATE ?= 115200
 HAS_ETHERNET ?= 1
 endif
 
+UART_CLOCK_FREQUENCY ?= $(CLOCK_FREQUENCY)
+
 ifeq ($(CC),cc)
   CC = $(RISCV)/bin/${CROSSCOMPILE}gcc
   OBJCOPY = $(RISCV)/bin/$(CROSSCOMPILE)objcopy
 endif
 SED = sed
-PLATFORM_DEFINES = -DCLOCK_FREQUENCY=$(CLOCK_FREQUENCY) -DUART_BITRATE=$(UART_BITRATE) -D$(PLATFORM)  -DXLEN=$(XLEN)
+PLATFORM_DEFINES = -DCLOCK_FREQUENCY=$(CLOCK_FREQUENCY) -DUART_CLOCK_FREQUENCY=$(UART_CLOCK_FREQUENCY) -DUART_BITRATE=$(UART_BITRATE) -D$(PLATFORM)  -DXLEN=$(XLEN)
 
 ifeq ($(XLEN), 64)
 CFLAGS = $(PLATFORM_DEFINES) -Os -ggdb -march=rv64im_zicsr -mabi=lp64 -Wall -mcmodel=medany -mexplicit-relocs -ffreestanding
@@ -90,5 +92,6 @@ $(MAIN): $(DTB) $(OBJS_C) $(OBJS_S) linker.lds
 	       -e "s/DRAM_SIZE_32/$(DRAM_SIZE_32)/g" \
 	       -e "s/HALF_CLOCK_FREQUENCY/$(HALF_CLOCK_FREQUENCY)/g" \
+	       -e "s/UART_CLOCK_FREQUENCY/$(UART_CLOCK_FREQUENCY)/g" \
 	       -e "s/CLOCK_FREQUENCY/$(CLOCK_FREQUENCY)/g" \
 	       -e "s/UART_BITRATE/$(UART_BITRATE)/g" \
 	       $(SED_DELETE_OPT) $< > $@
diff --git a/corev_apu/fpga/src/bootrom/cv64a6.dts.in b/corev_apu/fpga/src/bootrom/cv64a6.dts.in
--- a/corev_apu/fpga/src/bootrom/cv64a6.dts.in
+++ b/corev_apu/fpga/src/bootrom/cv64a6.dts.in
@@ -74,7 +74,7 @@
     uart@10000000 {
       compatible = "ns16550a";
       reg = <0x0 0x10000000 0x0 0x1000>;
-      clock-frequency = <CLOCK_FREQUENCY>;
+      clock-frequency = <UART_CLOCK_FREQUENCY>;
       current-speed = <UART_BITRATE>;
       interrupt-parent = <&PLIC0>;
       interrupts = <1>;
diff --git a/corev_apu/fpga/src/bootrom/src/main.c b/corev_apu/fpga/src/bootrom/src/main.c
index fa11e446..62c8d88c 100644
--- a/corev_apu/fpga/src/bootrom/src/main.c
+++ b/corev_apu/fpga/src/bootrom/src/main.c
@@ -49,7 +49,7 @@ int main()
 
 
     #ifndef PLAT_AGILEX
-    init_uart(CLOCK_FREQUENCY, UART_BITRATE); //not needed in intel setup as UART IP is already configured via HW
+    init_uart(UART_CLOCK_FREQUENCY, UART_BITRATE); //not needed in intel setup as UART IP is already configured via HW
     #endif 
     print_uart("Hello World!\r\n");
 
