+    volatile struct smp_mailbox *mailbox = (volatile struct smp_mailbox *)SMP_MAILBOX_ADDRESS;
+    mailbox->entry = entry;
+    mailbox->dtb = dtb;
+    __asm__ volatile ("fence rw, rw" ::: "memory");
+    mailbox->release = SMP_RELEASE_MAGIC;
+    __asm__ volatile ("fence rw, rw" ::: "memory");
