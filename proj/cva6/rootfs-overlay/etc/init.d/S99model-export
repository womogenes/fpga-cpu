#!/bin/sh

case " $(cat /proc/cmdline) " in
    *" fpga_model_size="*) ;;
    *) exit 0 ;;
esac

size="$(sed -n 's/.*[[:space:]]fpga_model_size=\([0-9][0-9]*\).*/\1/p' /proc/cmdline)"
test -n "$size" || exit 0
test -s /root/models/LFM2.5-350M-Q4_0.gguf && exit 0

if ! grep -qs ' /root/models tmpfs ' /proc/mounts; then
    mount -t tmpfs -o size=224m,mode=0755 modeltmpfs /root/models || {
        echo "Could not allocate the model filesystem; continuing without a model."
        exit 0
    }
fi

echo "Exporting staged LFM weights from reserved DDR..."
if model-export "$size"; then
    echo "LFM weights are ready in /root/models."
else
    rm -f /root/models/LFM2.5-350M-Q4_0.gguf
    echo "No staged LFM weights found; continuing without a model."
fi
